# Nur für den optionalen KI-Chat. Ohne Key läuft das Spiel komplett ohne Chat.
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
# Optional: dauerhaftes Rate-Limit über mehrere Server-Instanzen (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional: Chat nur von dieser Domain erlauben, z. B. https://teehaus.vercel.app
# ALLOWED_ORIGIN=
